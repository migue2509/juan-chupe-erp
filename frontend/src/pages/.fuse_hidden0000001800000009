                  {emp.security_enabled ? '🔒 Activo' : 'Sin bloqueo'}
                </span>
                <span className="text-sm font-bold text-gray-900 tabular-nums">{fmt(emp.weekly_total)}</span>
                <button onClick={() => setScheduleModal(emp)}
