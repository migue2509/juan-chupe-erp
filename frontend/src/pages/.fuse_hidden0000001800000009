      {/* ── TAB: HISTORIAL ── */}
      {tab === 'history' && (() => {
        const filteredHistory = history.filter(p => {
          const d = p.paid_at.slice(0, 10)
          if (histFrom && d < histFrom) return false
          if (histTo   && d > histTo)   return false
          return true
        })
        return (
        <div className="space-y-4">
          {/* Filtro */}
